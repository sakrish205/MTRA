/PROG RASTER25
/ATTR
OWNER          = MNEDITOR;
COMMENT        = "synthetic raster";
DEFAULT_GROUP  = 1,*,*,*,*;
/MN
1:  DO[1]=OFF ;
2:  J P[1] 100% FINE ;
3:  DO[1]=OFF ;
4:  L P[2] 200mm/sec CNT100 ;
5:  DO[1]=ON ;
6:  L P[3] 200mm/sec CNT100 ;
7:  L P[4] 200mm/sec CNT100 ;
8:  DO[1]=OFF ;
9:  L P[5] 200mm/sec CNT100 ;
10:  DO[1]=ON ;
11:  L P[6] 200mm/sec CNT100 ;
12:  L P[7] 200mm/sec CNT100 ;
13:  DO[1]=OFF ;
14:  L P[8] 200mm/sec CNT100 ;
15:  DO[1]=ON ;
16:  L P[9] 200mm/sec CNT100 ;
17:  L P[10] 200mm/sec CNT100 ;
18:  DO[1]=OFF ;
19:  L P[11] 200mm/sec CNT100 ;
20:  DO[1]=ON ;
21:  L P[12] 200mm/sec CNT100 ;
22:  L P[13] 200mm/sec CNT100 ;
23:  DO[1]=OFF ;
24:  L P[14] 200mm/sec CNT100 ;
25:  DO[1]=ON ;
26:  L P[15] 200mm/sec CNT100 ;
27:  L P[16] 200mm/sec CNT100 ;
28:  DO[1]=OFF ;
29:  L P[17] 200mm/sec CNT100 ;
30:  DO[1]=ON ;
31:  L P[18] 200mm/sec CNT100 ;
32:  L P[19] 200mm/sec CNT100 ;
33:  DO[1]=OFF ;
34:  L P[20] 200mm/sec CNT100 ;
35:  DO[1]=ON ;
36:  L P[21] 200mm/sec CNT100 ;
37:  L P[22] 200mm/sec CNT100 ;
38:  DO[1]=OFF ;
39:  L P[23] 200mm/sec CNT100 ;
40:  DO[1]=ON ;
41:  L P[24] 200mm/sec CNT100 ;
42:  L P[25] 200mm/sec CNT100 ;
43:  DO[1]=OFF ;
44:  L P[26] 200mm/sec CNT100 ;
45:  DO[1]=ON ;
46:  L P[27] 200mm/sec CNT100 ;
47:  L P[28] 200mm/sec CNT100 ;
48:  DO[1]=OFF ;
49:  J P[29] 100% FINE ;
/POS
P[1]{
   GP1:
	UF : 0, UT : 1,		CONFIG : 'N U T, 0, 0, 0',
